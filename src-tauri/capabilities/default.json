{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "M01 minimal permissions for the H!veAI main desktop window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "log:default",
    "notification:default",
    "allow-native-status",
    "allow-frontend-ready",
    "allow-akilta-external-link",
    "allow-startup-intro-claim",
    "allow-request-restart",
    "allow-runtime-status",
    "allow-database-status",
    "allow-command-center-read",
    "allow-project-registry",
    "allow-project-cockpit",
    "allow-control-plane",
    "allow-git-engine-read",
    "allow-filesystem-watcher",
    "allow-task-source-discovery",
    "allow-task-intelligence",
    "allow-workflow-state-machine",
    "allow-codex-adapter",
    "allow-agent-session-center",
    "allow-prompt-engine",
    "allow-audit-engine"
  ]
}
