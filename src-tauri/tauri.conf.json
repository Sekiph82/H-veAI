{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "H!veAI",
  "version": "0.1.0",
  "identifier": "ai.hiveai.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "H!veAI",
        "width": 1100,
        "height": 760,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "center": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
    "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "publisher": "H!veAI",
    "copyright": "Copyright 2026 H!veAI",
    "category": "DeveloperTool",
    "shortDescription": "AI Development Command Center",
    "longDescription": "H!veAI is a local-first AI Development Command Center."
  }
}
